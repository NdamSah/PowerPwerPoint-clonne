<UserControl x:Class="PowerPwerPoint.Media.Vues.PanneauTransitions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="380" d:DesignHeight="700"
             Background="{StaticResource FondPanneau}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
            <TextBlock Text="Transition" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextePrincipal}" Margin="0,0,0,2" />
            <TextBlock Text="Effet appliqué à l'arrivée sur cette diapositive." Style="{StaticResource Etiquette}" Margin="0,0,0,8" />

            <ListBox x:Name="Galerie" ItemsSource="{Binding Galerie}"
                     SelectedValuePath="Effet" SelectedValue="{Binding EffetSelectionne, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Carte" Width="98" Height="82" CornerRadius="6"
                                            Background="White" BorderBrush="{StaticResource BordureDouce}" BorderThickness="1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Carte" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Carte" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Carte" Property="Background" Value="#FFE8EFFD" />
                                            <Setter TargetName="Carte" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel VerticalAlignment="Center" Margin="4">
                            <TextBlock Text="{Binding Glyphe}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       HorizontalAlignment="Center" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="{Binding Nom}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Foreground="{StaticResource TextePrincipal}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding DescriptionEffet}" Style="{StaticResource Etiquette}" TextWrapping="Wrap" Margin="0,0,0,8" />

            <TextBlock Style="{StaticResource TitrePanneau}" Text="OPTIONS D'EFFET" />
            <TextBlock Style="{StaticResource Etiquette}" Text="Direction" />
            <ComboBox ItemsSource="{Binding SensPossibles}" DisplayMemberPath="Libelle"
                      SelectedValuePath="Valeur" SelectedValue="{Binding Transition.Sens, Mode=TwoWay}"
                      IsEnabled="{Binding AccepteSens}" Margin="0,2,0,8" />

            <TextBlock Style="{StaticResource Etiquette}" Text="Durée" />
            <Grid Margin="0,2,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="0.1" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        Value="{Binding Transition.Duree, Mode=TwoWay}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource Etiquette}" Width="46" TextAlignment="Right"
                           Text="{Binding Transition.Duree, StringFormat={}{0:0.0} s}" />
            </Grid>

            <TextBlock Style="{StaticResource TitrePanneau}" Text="SON" />
            <ComboBox ItemsSource="{Binding Sons}" DisplayMemberPath="Nom"
                      SelectedValuePath="Chemin" SelectedValue="{Binding SonSelectionne, Mode=TwoWay}"
                      Margin="0,2,0,6" />
            <WrapPanel>
                <Button Style="{StaticResource BoutonAction}" Content="Choisir…" Command="{Binding ChoisirSonCommand}" />
                <Button Style="{StaticResource BoutonAction}" Content="Tester" Command="{Binding TesterSonCommand}" />
                <Button Style="{StaticResource BoutonAction}" Content="Retirer" Command="{Binding RetirerSonCommand}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource TitrePanneau}" Text="AVANCER" />
            <CheckBox Style="{StaticResource CaseACocher}" Content="Après un délai (sinon au clic)"
                      IsChecked="{Binding Transition.AvanceAutomatique, Mode=TwoWay}" />
            <Grid Margin="0,2,0,4" IsEnabled="{Binding Transition.AvanceAutomatique}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Etiquette}" Text="Délai :" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Style="{StaticResource Champ}"
                         Text="{Binding Transition.DelaiAvance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Etiquette}" Text="secondes" Margin="6,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding ResumeAvancement}" Style="{StaticResource Etiquette}" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource BoutonPrimaire}" Content="Aperçu" Command="{Binding ApercuCommand}" />
                <Button Style="{StaticResource BoutonAction}" Content="Appliquer partout" Command="{Binding AppliquerPartoutCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
