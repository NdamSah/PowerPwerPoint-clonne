<Window x:Class="PowerPwerPoint.Media.Presentation.DialogueLien"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insérer un lien"
        Width="470" Height="330"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Type de lien" FontSize="11" Foreground="#FF6A7180" />
        <ComboBox x:Name="ComboTypeLien" Grid.Row="0" DisplayMemberPath="Libelle" SelectedValuePath="Valeur"
                  Margin="0,16,0,8" SelectionChanged="SurTypeModifie" />

        <TextBlock Grid.Row="1" Text="Adresse / cible" FontSize="11" Foreground="#FF6A7180" />
        <Grid Grid.Row="1" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Cible" Grid.Column="0" Padding="4,3" />
            <Button x:Name="BoutonParcourir" Grid.Column="1" Content="Parcourir…" Padding="10,3" Margin="6,0,0,0"
                    Click="SurParcourir" Visibility="Collapsed" />
        </Grid>

        <TextBlock Grid.Row="2" Text="Info-bulle" FontSize="11" Foreground="#FF6A7180" />
        <TextBox x:Name="InfoBulle" Grid.Row="2" Margin="0,16,0,8" Padding="4,3" />

        <TextBlock Grid.Row="3" Text="Élément porteur du lien" FontSize="11" Foreground="#FF6A7180" />
        <ComboBox x:Name="Element" Grid.Row="3" DisplayMemberPath="Nom" SelectedValuePath="Id" Margin="0,16,0,8" />

        <TextBlock Grid.Row="4" TextWrapping="Wrap" FontSize="11" Foreground="#FF6A7180"
                   Text="Le lien s'ouvre pendant le diaporama, au clic sur l'élément (ou n'importe où sur la diapositive si aucun élément n'est choisi)." />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Valider" Width="96" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="SurValider" />
            <Button Content="Annuler" Width="96" Padding="0,6" IsCancel="True" Click="SurAnnuler" />
        </StackPanel>
    </Grid>
</Window>
