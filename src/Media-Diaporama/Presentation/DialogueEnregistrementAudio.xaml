<Window x:Class="PowerPwerPoint.Media.Presentation.DialogueEnregistrementAudio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enregistrer un son"
        Width="430" Height="290"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12"
                   Text="Enregistrez une narration depuis le microphone par défaut. Le fichier WAV est ajouté à la diapositive courante." />

        <TextBlock x:Name="Chrono" Grid.Row="1" FontFamily="Consolas" FontSize="30" Margin="0,12,0,4" Text="00:00" />
        <ProgressBar x:Name="Niveau" Grid.Row="2" Height="10" Minimum="0" Maximum="100" Margin="0,0,0,10" />

        <TextBlock x:Name="Message" Grid.Row="3" TextWrapping="Wrap" Foreground="#FF6A7180" FontSize="11" />

        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <Button x:Name="BoutonEnregistrer" Content="● Enregistrer" Padding="14,6" Margin="0,0,8,0" Click="SurEnregistrer" />
            <Button x:Name="BoutonArreter" Content="■ Arrêter" Padding="14,6" Margin="0,0,8,0" Click="SurArreter" IsEnabled="False" />
            <Button x:Name="BoutonLire" Content="▶ Écouter" Padding="14,6" Margin="0,0,8,0" Click="SurLire" IsEnabled="False" />
            <Button x:Name="BoutonValider" Content="Utiliser ce son" Padding="14,6" Margin="0,0,8,0" Click="SurValider" IsDefault="True" />
            <Button Content="Annuler" Padding="14,6" IsCancel="True" Click="SurAnnuler" />
        </WrapPanel>
    </Grid>
</Window>
