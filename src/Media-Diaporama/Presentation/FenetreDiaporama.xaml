<Window x:Class="PowerPwerPoint.Media.Presentation.FenetreDiaporama"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PowerPwerPoint.Media.Vues"
        Title="Diaporama"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Black"
        PreviewKeyDown="SurTouche"
        MouseLeftButtonDown="SurClicGauche"
        MouseMove="SurMouvementSouris">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Diapositive suivante" Click="SurMenuSuivante" />
            <MenuItem Header="Diapositive précédente" Click="SurMenuPrecedente" />
            <Separator />
            <MenuItem Header="Écran noir (B)" Click="SurMenuEcranNoir" />
            <MenuItem Header="Écran blanc (W)" Click="SurMenuEcranBlanc" />
            <MenuItem Header="Pointeur laser (L)" Click="SurMenuLaser" />
            <Separator />
            <MenuItem Header="Mode présentateur" Click="SurMenuPresentateur" />
            <Separator />
            <MenuItem Header="Terminer le diaporama" Click="SurMenuTerminer" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Racine" Background="Black">
        <Grid>
            <v:RenduDiapositive x:Name="CoucheA" Visibility="Collapsed" />
            <v:RenduDiapositive x:Name="CoucheB" Visibility="Collapsed" />
        </Grid>

        <Canvas x:Name="CalqueLaser" IsHitTestVisible="False">
            <Ellipse x:Name="Pointeur" Width="16" Height="16" Fill="#FFFF2D2D" Visibility="Collapsed">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FFFF2D2D" BlurRadius="18" ShadowDepth="0" Opacity="0.95" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Border x:Name="VoileEcran" Background="Black" Visibility="Collapsed" IsHitTestVisible="False" />

        <Border x:Name="BandeauSaisie" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,40,0,0" Padding="14,8" CornerRadius="6" Background="#CC000000"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="TexteSaisie" Foreground="White" FontSize="18" FontFamily="Segoe UI" />
        </Border>

        <TextBlock x:Name="IndicateurMasquage" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,26" Foreground="#AAFFFFFF" FontSize="13"
                   Text="Diapositive masquée" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
