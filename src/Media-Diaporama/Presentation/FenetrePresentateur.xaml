<Window x:Class="PowerPwerPoint.Media.Presentation.FenetrePresentateur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:PowerPwerPoint.Media.Vues"
        Title="Mode Présentateur"
        WindowStartupLocation="CenterScreen"
        Width="1100" Height="720"
        Background="#FF15192A">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Mode Présentateur" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="NumeroDiapositive" Foreground="#FF9FB0CC" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="ChronoTotal" Foreground="White" FontSize="22" FontFamily="Consolas"
                       Margin="28,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="ChronoDiapositive" Foreground="#FF7FA6FF" FontSize="14" FontFamily="Consolas"
                       Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="Black" CornerRadius="8" Padding="2" Margin="0,0,14,0">
            <v:RenduDiapositive x:Name="RenduCourant" />
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="DIAPOSITIVE SUIVANTE" Foreground="#FF9FB0CC" FontSize="11" FontWeight="SemiBold" />
            <Border Grid.Row="1" Background="Black" CornerRadius="6" Height="120" Margin="0,6,0,12">
                <v:RenduDiapositive x:Name="RenduSuivant" />
            </Border>

            <Border Grid.Row="2" Background="#FF1F2435" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="NOTES" Foreground="#FF9FB0CC" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock x:Name="NotesDiapositive" Foreground="White" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="BoutonPrecedent" Content="◀ Précédent" Padding="14,7" Margin="0,0,8,0" Click="SurPrecedent" />
                <Button x:Name="BoutonSuivant" Content="Suivant ▶" Padding="14,7" Margin="0,0,8,0" Click="SurSuivant" />
                <Button x:Name="BoutonPause" Content="Pause" Padding="14,7" Margin="0,0,8,0" Click="SurPause" />
                <Button Content="Terminer" Padding="14,7" Click="SurTerminer" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
