<Window x:Class="PowerPwerPoint.Media.Presentation.DialogueZoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zoom"
        Width="420" Height="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Titre du zoom" FontSize="11" Foreground="#FF6A7180" />
            <TextBox x:Name="Titre" Margin="0,2,0,10" Padding="4,3" />
            <TextBlock Text="Type de zoom" FontSize="11" Foreground="#FF6A7180" />
            <ComboBox x:Name="ComboType" DisplayMemberPath="Libelle" SelectedValuePath="Valeur" Margin="0,2,0,10" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Diapositives ciblées (glisser pour sélectionner)" FontSize="11" Foreground="#FF6A7180" />
        <ListBox x:Name="Diapositives" Grid.Row="2" Margin="0,4,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Libelle}" IsChecked="{Binding Selectionnee, Mode=TwoWay}" Margin="2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Valider" Width="96" Padding="0,6" Margin="0,0,8,0" IsDefault="True" Click="SurValider" />
            <Button Content="Annuler" Width="96" Padding="0,6" IsCancel="True" Click="SurAnnuler" />
        </StackPanel>
    </Grid>
</Window>
