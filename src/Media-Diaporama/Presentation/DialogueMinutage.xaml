<Window x:Class="PowerPwerPoint.Media.Presentation.DialogueMinutage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vérification du minutage"
        Width="520" Height="470"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="12"
                   Text="Durées enregistrées pendant la répétition ou l'enregistrement du diaporama. Appliquez-les pour faire avancer automatiquement chaque diapositive." />

        <ListBox x:Name="Lignes" Grid.Row="1" Margin="0,10,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Numero}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Titre}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding DureeTexte}" FontFamily="Consolas" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="Total" Grid.Row="2" FontSize="13" FontWeight="SemiBold" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Appliquer les minutages" Width="150" Padding="0,6" Margin="0,0,8,0" Click="SurAppliquer" />
            <Button Content="Effacer" Width="80" Padding="0,6" Margin="0,0,8,0" Click="SurEffacer" />
            <Button Content="Fermer" Width="96" Padding="0,6" IsCancel="True" Click="SurFermer" />
        </StackPanel>
    </Grid>
</Window>
