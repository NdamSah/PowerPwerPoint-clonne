<Window x:Class="PowerPwerPoint.Media.Presentation.LecteurVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vidéo — lecture et rognage"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#FF15192A">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black" CornerRadius="8">
            <MediaElement x:Name="Lecteur" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="NomFichier" Foreground="White" FontSize="13" />
            <Slider x:Name="Position" Minimum="0" Maximum="1" Margin="0,6,0,2"
                    Thumb.DragStarted="SurDebutDeplacement" Thumb.DragCompleted="SurFinDeplacement" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TempsCourant" Grid.Column="0" Foreground="#FF9FB0CC" FontFamily="Consolas" FontSize="12" />
                <TextBlock x:Name="TempsTotal" Grid.Column="2" Foreground="#FF9FB0CC" FontFamily="Consolas" FontSize="12" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="ROGNAGE (non destructif)" Foreground="#FF9FB0CC" FontSize="11" FontWeight="SemiBold" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Début" Foreground="White" VerticalAlignment="Center" />
                <Slider x:Name="BorneDebut" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="SurBorneModifiee" />
                <Button Grid.Column="2" Content="= position" Padding="8,3" Margin="8,0,0,0" Click="SurDefinirDebut" />
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Fin" Foreground="White" VerticalAlignment="Center" />
                <Slider x:Name="BorneFin" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="SurBorneModifiee" />
                <Button Grid.Column="2" Content="= position" Padding="8,3" Margin="8,0,0,0" Click="SurDefinirFin" />
            </Grid>
            <TextBlock x:Name="ResumeRognage" Foreground="#FF9FB0CC" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BoutonLecture" Content="▶ Lire" Padding="14,6" Margin="0,0,8,0" Click="SurLecture" />
            <Button Content="⏹ Arrêter" Padding="14,6" Margin="0,0,8,0" Click="SurArreter" />
            <Button Content="Réinitialiser le rognage" Padding="14,6" Margin="0,0,8,0" Click="SurReinitialiser" />
            <TextBlock Text="Volume" Foreground="White" VerticalAlignment="Center" Margin="8,0,6,0" />
            <Slider x:Name="Volume" Width="110" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center"
                    ValueChanged="SurVolumeModifie" />
            <CheckBox x:Name="Boucle" Content="Lire en boucle" Foreground="White" Margin="12,0,0,0"
                      VerticalAlignment="Center" />
            <Button Content="Fermer" Padding="14,6" Margin="18,0,0,0" IsDefault="True" Click="SurFermer" />
        </StackPanel>
    </Grid>
</Window>
