<UserControl x:Class="PowerPointClone.InterfaceQualite.RubanCoque.RubanInterface"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="Affichage">
            <StackPanel Orientation="Horizontal" Margin="8">
                <CheckBox Content="Règles" Margin="8" IsChecked="{Binding ReglesVisibles}"/>
                <CheckBox Content="Grille" Margin="8" IsChecked="{Binding GrilleVisible}"/>
                <CheckBox Content="Repères" Margin="8" IsChecked="{Binding ReperesVisibles}"/>
                <TextBlock Text="Zoom (%)" VerticalAlignment="Center" Margin="8"/>
                <Slider Width="160" Minimum="10" Maximum="400" Value="{Binding Zoom}"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Révision">
            <TextBlock Margin="12" Text="Commentaires • Orthographe • Accessibilité"/>
        </TabItem>
        <TabItem Header="Conception">
            <TextBlock Margin="12" Text="Thèmes • Variantes • Taille • Arrière-plan • Masque"/>
        </TabItem>
    </TabControl>
</UserControl>