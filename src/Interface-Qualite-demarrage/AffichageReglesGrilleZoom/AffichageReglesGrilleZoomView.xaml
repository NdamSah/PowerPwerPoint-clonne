<UserControl x:Class="PowerPointClone.InterfaceQualite.AffichageReglesGrilleZoom.AffichageReglesGrilleZoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="220">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DrawingBrush x:Key="SlideGridBrush" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H20 V20 H0 Z" />
                    <GeometryDrawing>
                        <GeometryDrawing.Pen><Pen Brush="#55909090" Thickness="0.6" /></GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry><GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="20,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,20" />
                        </GeometryGroup></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <DockPanel Background="#FFF3F3F3">
        <Border DockPanel.Dock="Top" Background="White" Padding="8" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <CheckBox Content="Règles" IsChecked="{Binding ShowRulers, Mode=TwoWay}" Margin="4,0,14,0" VerticalAlignment="Center" />
                <CheckBox Content="Grille" IsChecked="{Binding ShowGrid, Mode=TwoWay}" Margin="4,0,14,0" VerticalAlignment="Center" />
                <Button Content="−" Width="30" Margin="2" Command="{Binding ZoomOutCommand}" ToolTip="Dézoomer" />
                <Slider Width="130" Minimum="25" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding ZoomPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                <Button Content="+" Width="30" Margin="2" Command="{Binding ZoomInCommand}" ToolTip="Zoomer" />
                <TextBlock Text="{Binding ZoomLabel}" Width="48" VerticalAlignment="Center" TextAlignment="Center" />
                <Button Content="100 %" Margin="3,0" Padding="7,3" Command="{Binding ActualSizeCommand}" />
                <Button Content="Adapter" Margin="3,0" Padding="7,3" Command="{Binding FitToWindowCommand}" />
            </WrapPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="1" Background="#FFE8E8E8"
                    Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="0        1        2        3        4        5        6        7        8" FontSize="10"
                           Foreground="#FF555555" VerticalAlignment="Center" Margin="8,0" />
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Background="#FFE8E8E8"
                    Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="0&#10;&#10;1&#10;&#10;2&#10;&#10;3&#10;&#10;4&#10;&#10;5" FontSize="10"
                           Foreground="#FF555555" HorizontalAlignment="Center" Margin="0,5" />
            </Border>

            <ScrollViewer Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid MinWidth="500" MinHeight="300" Background="#FFD6D6D6">
                    <ContentControl x:Name="SlideHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <Border IsHitTestVisible="False" Background="{StaticResource SlideGridBrush}"
                            Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
